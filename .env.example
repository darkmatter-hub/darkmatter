# DarkMatter environment variables
# Copy to .env and fill in. Never commit .env.
#
# Every variable src/ reads is listed here, including the ones that are
# optional, because four of them change security behaviour when unset and
# nothing said so. test/smoke.test.js fails if src/ reads one that is missing
# from this file.

# ── Supabase — required ─────────────────────────────────
# Settings → API → Project URL
SUPABASE_URL=https://yourproject.supabase.co

# Settings → API → anon/public key
SUPABASE_KEY=your-anon-key-here

# Settings → API → service_role key (keep this secret)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Settings → API → JWT Secret. Used to verify session tokens.
SUPABASE_JWT_SECRET=your-jwt-secret

# ── URLs — required ─────────────────────────────────────
# OAuth redirects and magic links.
APP_URL=http://localhost:3000

# Canonical origin for robots.txt, sitemap.xml and email links.
# Defaults to https://darkmatterhub.ai when unset, which is wrong for a
# self-hosted deployment.
BASE_URL=http://localhost:3000

PORT=3000

# ── Security — unset means degraded, not broken ─────────
# AES-256-GCM key (64 hex characters) for values stored at rest: webhook
# secrets and provider API keys.
#
# UNSET: those values are written as "plain:<secret>" in the database, in
# plaintext, with only a console warning. The enterprise page states that these
# are encrypted at rest, so a deployment without this key does not match what
# the product claims. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DM_ENCRYPTION_KEY=

# Ed25519 private key (PEM) that signs checkpoints of the append-only log.
#
# UNSET: a key is generated at boot and dies on the next restart, so the
# checkpoint scheduler refuses to publish. A checkpoint signed by a key nobody
# can obtain afterwards is worthless, which is why it fails closed. Generate:
#   node keygen.js
DM_LOG_SIGNING_KEY_PEM=

# Admin access. SUPERUSER_EMAIL gates the dashboard admin views;
# SUPERUSER_AGENT_ID gates POST /api/admin/*. Unset means nobody is an admin.
SUPERUSER_EMAIL=
SUPERUSER_AGENT_ID=

# ── External checkpoint publication — optional ──────────
# Publishes each signed checkpoint to a public repository, so the log root is
# recorded somewhere the operator does not control. Unset means checkpoints
# stay in our own database and nothing outside can contradict a rewrite.
DM_GITHUB_TOKEN=
DM_GITHUB_CHECKPOINT_REPO=

# ── Billing — optional, needed for paid plans ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAMS=
STRIPE_PRICE_ENTERPRISE=

# ── Email — optional ────────────────────────────────────
# Without a Resend key, contact forms and reports are logged, not sent.
RESEND_API_KEY=
FEEDBACK_EMAIL=
GROWTH_REPORT_EMAIL=
GROWTH_REPORT_TO=
GROWTH_REPORT_DISABLED=

# ── Background jobs — optional switches ─────────────────
# Retention deletes payloads past their plan's window. DRY_RUN logs what it
# would redact without touching anything.
RETENTION_DISABLED=
RETENTION_DRY_RUN=

# Keeps a free-tier Supabase project from being paused for inactivity.
KEEPALIVE_DISABLED=
